<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GPTBridge.MainSystem</RootNamespace>
    <AssemblyName>GPTBridge.MainSystem</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Release publish: R2R precompiles IL to native images for faster
         startup; effective only when a RID is supplied at publish time. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

</Project>
