{
  "id": "investment-mobile",
  "name_key": "tool.name",
  "description_key": "tool.description",
  "version": "1.0.0",
  "display_version": "1.0",
  "status": "stopped",
  "enabled": true,
  "independent_tool": true,
  "main_system_independent_tool": true,
  "canonical_source_root": "investment-mobile",
  "physical_owner_root": "investment-mobile",
  "lifecycle": {
    "startup": "on-demand",
    "directLoad": false,
    "encapsulated": true,
    "optional": true,
    "stoppable": true,
    "disableable": true,
    "unloadable": true
  },
  "shared_permission_owner": "ai-assistant",
  "shared_permission_profile": "ai-investment-manager-v1",
  "shared_cache_owner": "ai-assistant",
  "cache_storage": "ai-assistant/runtime/cache/companions/investment-mobile",
  "backup_owner": "ai-assistant",
  "backup_storage": "system-rescue/data/business/backups/investment-mobile",
  "permissions": {
    "profile": "ai-investment-manager-v1",
    "business_permission_owner": "ai-assistant",
    "settings_owner": "ai-assistant",
    "code_scope": "tool-root-only",
    "database_scope": "tool-database-only",
    "canonical_database_scope": "xingcheng-shared-repository",
    "allow_modify": [
      "mobile-interface-via-investment-mobile-owner"
    ],
    "deny": [
      "main-program",
      "other-tools",
      "direct-database-write",
      "separate-business-database",
      "separate-settings-layer"
    ]
  },
  "runtime": {
    "type": "python",
    "entry": "src/channel_runtime.py",
    "workingDirectory": "."
  },
  "distribution": {
    "mode": "special-unpackaged",
    "package": false
  },
  "request_channel": {
    "model": "governance-authenticated-shared-layer",
    "runtime_entry": "src/channel_runtime.py",
    "direct_instruction": "PERMISSION_DENIED"
  },
  "launch": {
    "primary": "governed-source-channel",
    "background": "governed-source-channel"
  },
  "capabilities": {
    "ai-connections": {
      "entry_gateway": "xingcheng",
      "direct_model_access": false,
      "model_selection": "automatic-only",
      "source_owner": "investment-mobile",
      "runtime_independence": true,
      "main_system_independent_tool": true,
      "business_layer_owner": "investment-mobile",
      "settings_owner": "investment-mobile",
      "permission_profile": "ai-investment-manager-v1",
      "separate_business_layer": false,
      "separate_settings_layer": false
    },
    "investment-analysis": {
      "entry_gateway": "investment-mobile",
      "source_owner": "investment-mobile",
      "runtime_independence": true
    },
    "investment-manager": {
      "entry_gateway": "investment-mobile",
      "source_owner": "investment-mobile",
      "runtime_independence": true
    },
    "investment-market-search": {
      "entry_gateway": "investment-mobile",
      "source_owner": "investment-mobile",
      "runtime_independence": true
    }
  },
  "environment": {
    "allow": [
      "GPTBRIDGE_INVESTMENT_MOBILE_ENABLED",
      "GPTBRIDGE_INVESTMENT_MOBILE_ALLOW_LAN",
      "GPTBRIDGE_INVESTMENT_MOBILE_PORT"
    ]
  },
  "has_custom_ui": false,
  "window": {
    "width": 900,
    "height": 720,
    "minWidth": 720,
    "minHeight": 560,
    "title_key": "tool.window_title"
  },
  "test_targets": [
    "tests/test_investment_mobile_reexport.py",
    "tests/test_trading_engines.py",
    "tests/test_market_acceptance.py",
    "tests/test_fund_acceptance.py"
  ],
  "product": "星澄 AI 投資管理與自動操盤系統",
  "trading_system": {
    "product": "星澄 AI 投資管理與自動操盤系統",
    "domains": [
      "market-data",
      "instrument",
      "portfolio",
      "strategy",
      "risk",
      "trading",
      "broker",
      "mutual-fund",
      "ai-analysis",
      "backtest",
      "audit"
    ],
    "engines": [
      "market-data",
      "strategy",
      "risk",
      "oms",
      "portfolio",
      "broker-adapter",
      "trading-audit",
      "mutual-fund"
    ],
    "business_domains_owner": "ai-assistant:tw-stock,us-stock,fund,ai-analysis,auto-trading,asset-management,market-data",
    "trading_modes": [
      "ANALYSIS",
      "SHADOW",
      "PAPER",
      "LIVE"
    ],
    "default_mode": "ANALYSIS",
    "live_requires": "explicit-human-authorization+verified-broker-api",
    "broker_adapters": {
      "tw": "CATHAY_SECURITIES",
      "us": "FUBON_SUBBROKERAGE",
      "fund": "MUTUAL_FUND_PROVIDER"
    },
    "native_components": {
      "risk_core": "native/risk/risk_core.c",
      "strategy_engine": "native/strategy/strategy_engine.cpp",
      "oms": "native/oms/InvestmentMobile.Oms.csproj"
    },
    "signal_owner": "xingcheng-analysis-only",
    "decision_owner": "independent-strategy-and-risk-engines",
    "business_layer_owner": "ai-assistant",
    "market_data": {
      "engine": "MarketDataEngine (centralized bounded ingestion; no per-symbol processes)",
      "markets": [
        "TWSE",
        "TPEx",
        "NYSE",
        "NASDAQ"
      ],
      "sources": "replaceable adapters; verified-only realtime; simulated/manual for tests",
      "live_quotes": "pending official source verification",
      "storage": "SQLite runtime cache + PostgreSQL gptbridge_trading market_* (migration 135)"
    },
    "fund_system": {
      "engine": "MutualFundEngine (trading/fund/) — identity, NAV, distribution, fee, performance, comparison, exposure, transactions, cost basis, recurring, recommendations, strategies",
      "identity": "fund:{fund_id}:{share_class}:{currency} — share classes never collapse",
      "nav_policy": "published/estimated/confirmed kept distinct; NAV is not a guaranteed execution price",
      "live_trading": "disabled — advisory and bookkeeping only this phase",
      "sources": "manual-import + controlled CSV/XLSX/JSON file import; TDCC/provider feeds pending verification",
      "storage": "JSON journal + PostgreSQL gptbridge_trading fund_* (migration 136)",
      "research": "Qdrant star-financial-research-v1 for prospectus semantic retrieval"
    }
  }
}
