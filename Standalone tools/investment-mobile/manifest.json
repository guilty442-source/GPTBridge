{
  "id": "investment-mobile",
  "name_key": "tool.name",
  "description_key": "tool.description",
  "version": "1.0.0",
  "display_version": "1.0",
  "status": "stopped",
  "enabled": true,
  "independent_tool": true,
  "main_system_independent_tool": true,
  "canonical_source_root": "investment-mobile",
  "physical_owner_root": "investment-mobile",
  "lifecycle": {
    "startup": "on-demand",
    "directLoad": false,
    "encapsulated": true,
    "optional": true,
    "stoppable": true,
    "disableable": true,
    "unloadable": true
  },
  "shared_permission_owner": "ai-assistant",
  "shared_permission_profile": "ai-investment-manager-v1",
  "shared_cache_owner": "ai-assistant",
  "cache_storage": "ai-assistant/runtime/cache/companions/investment-mobile",
  "backup_owner": "ai-assistant",
  "backup_storage": "system-rescue/data/business/backups/investment-mobile",
  "permissions": {
    "profile": "ai-investment-manager-v1",
    "business_permission_owner": "ai-assistant",
    "settings_owner": "ai-assistant",
    "code_scope": "tool-root-only",
    "database_scope": "tool-database-only",
    "canonical_database_scope": "xingcheng-shared-repository",
    "allow_modify": [
      "mobile-interface-via-investment-mobile-owner"
    ],
    "deny": [
      "main-program",
      "other-tools",
      "direct-database-write",
      "separate-business-database",
      "separate-settings-layer"
    ]
  },
  "runtime": {
    "type": "python",
    "entry": "src/channel_runtime.py",
    "workingDirectory": "."
  },
  "distribution": {
    "mode": "special-unpackaged",
    "package": false
  },
  "request_channel": {
    "model": "governance-authenticated-shared-layer",
    "runtime_entry": "src/channel_runtime.py",
    "direct_instruction": "PERMISSION_DENIED"
  },
  "launch": {
    "primary": "governed-source-channel",
    "background": "governed-source-channel"
  },
  "capabilities": {
    "ai-connections": {
      "entry_gateway": "xingcheng",
      "direct_model_access": false,
      "model_selection": "automatic-only",
      "source_owner": "investment-mobile",
      "runtime_independence": true,
      "main_system_independent_tool": true,
      "business_layer_owner": "investment-mobile",
      "settings_owner": "investment-mobile",
      "permission_profile": "ai-investment-manager-v1",
      "separate_business_layer": false,
      "separate_settings_layer": false
    },
    "investment-analysis": {
      "entry_gateway": "investment-mobile",
      "source_owner": "investment-mobile",
      "runtime_independence": true
    },
    "investment-manager": {
      "entry_gateway": "investment-mobile",
      "source_owner": "investment-mobile",
      "runtime_independence": true
    },
    "investment-market-search": {
      "entry_gateway": "investment-mobile",
      "source_owner": "investment-mobile",
      "runtime_independence": true
    }
  },
  "environment": {
    "allow": [
      "GPTBRIDGE_INVESTMENT_MOBILE_ENABLED",
      "GPTBRIDGE_INVESTMENT_MOBILE_ALLOW_LAN",
      "GPTBRIDGE_INVESTMENT_MOBILE_PORT"
    ]
  },
  "has_custom_ui": false,
  "window": {
    "width": 900,
    "height": 720,
    "minWidth": 720,
    "minHeight": 560,
    "title_key": "tool.window_title"
  },
  "test_targets": [
    "tests/test_investment_mobile_reexport.py",
    "tests/test_trading_engines.py"
  ],
  "product": "星澄 AI 投資管理與自動操盤系統",
  "trading_system": {
    "product": "星澄 AI 投資管理與自動操盤系統",
    "domains": [
      "tw-stock",
      "us-stock",
      "fund",
      "ai-analysis",
      "auto-trading",
      "asset-management"
    ],
    "engines": [
      "strategy",
      "risk",
      "oms",
      "portfolio",
      "broker-adapter",
      "trading-audit"
    ],
    "trading_modes": [
      "ANALYSIS",
      "SHADOW",
      "PAPER",
      "LIVE"
    ],
    "default_mode": "ANALYSIS",
    "live_requires": "explicit-human-authorization+verified-broker-api",
    "broker_adapters": {
      "tw": "cathay-tw",
      "us": "fubon-us-sub",
      "fund": "fund-platform-extensible"
    },
    "native_components": {
      "risk_core": "native/risk/risk_core.c",
      "strategy_engine": "native/strategy/strategy_engine.cpp",
      "oms": "native/oms/InvestmentMobile.Oms.csproj"
    },
    "signal_owner": "xingcheng-analysis-only",
    "decision_owner": "independent-strategy-and-risk-engines",
    "business_layer_owner": "ai-assistant"
  }
}
