{
  "schema_version": "star-native-inference-bundle/v1",
  "config": {
    "vocab_size": 16384, "hidden_size": 64, "intermediate_size": 128,
    "num_hidden_layers": 2, "num_attention_heads": 4,
    "num_key_value_heads": 4, "head_dim": 16,
    "max_position_embeddings": 256,
    "bos_token_id": 1, "eos_token_id": 2, "pad_token_id": 0,
    "rms_norm_eps": 1e-6, "rope_theta": 10000.0,
    "use_swiglu": true, "tie_word_embeddings": true,
    "norm_type": "rmsnorm", "hidden_act": "silu",
    "position_embedding_type": "rope",
    "use_moe": false, "use_vision": false
  }
}
