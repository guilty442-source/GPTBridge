{
  "id": "local-model",
  "name_key": "tool.name",
  "description_key": "tool.description",
  "version": "1.0.0",
  "display_version": "1.0",
  "status": "stopped",
  "enabled": true,
  "independent_tool": true,
  "main_system_independent_tool": true,
  "canonical_source_root": "local-model",
  "physical_owner_root": "local-model",
  "lifecycle": {
    "startup": "on-demand",
    "directLoad": false,
    "encapsulated": true,
    "optional": true,
    "stoppable": true,
    "disableable": true,
    "unloadable": true
  },
  "shared_permission_owner": "local-model",
  "shared_permission_profile": "local-model-platform-v1",
  "shared_cache_owner": "local-model",
  "cache_storage": "local-model/runtime/cache",
  "backup_owner": "local-model",
  "backup_storage": "main-system/data/recovery/backups/local-model",
  "permissions": {
    "profile": "local-model-platform-v1",
    "business_permission_owner": "local-model",
    "settings_owner": "local-model",
    "code_scope": "tool-root-only",
    "database_scope": "tool-database-only",
    "canonical_database_scope": "xingcheng-shared-repository",
    "allow_modify": [],
    "deny": [
      "main-program",
      "other-tools",
      "direct-database-write",
      "separate-business-database",
      "separate-settings-layer"
    ]
  },
  "runtime": {    "type": "csharp", "native_entry": "dist/GPTBridge.ToolHost.App.exe",    "retired_entry": "src/channel_runtime.py",    "note": "Python lane retired (B167/B38); governed launch runs the C# ToolHost host shell only — the xc-model-service (/v1/* + xc_modeltool worker + descriptor contract) is owned by the xingcheng ToolHost process, not by local-model. local-model does not own, host, or control the model service.",    "workingDirectory": "."  },
  "distribution": {
    "mode": "special-unpackaged",
    "package": false
  },
  "request_channel": {
    "model": "governance-authenticated-shared-layer",
    "runtime_entry": "shared-layer/csharp/GPTBridge.ChannelHost/publish/GPTBridge.ChannelHost.exe",
    "direct_instruction": "PERMISSION_DENIED"
  },
  "launch": {
    "primary": "governed-source-channel",
    "background": "governed-source-channel"
  },
  "automation": {
    "retired_entry": "xingcheng/src/backend/services/xingcheng/application/local_ai_lifecycle.py",
    "class": "LocalAiLifecycleMixin",
    "method": "_internal_maintenance_loop",
    "enabled": false,
    "surfaces": [
      {
        "id": "retention",
        "kind": "governed-command",
        "command": "xingcheng_retention_sweep"
      }
    ]
  },
  "capabilities": {
    "xingcheng": {
      "star_native_model_permissions": {
        "database_write": true,
        "database_write_scope": "xingcheng-model-internal-unrestricted-excluding-permission-data",
        "investment_database_write": true
      }
    }
  },
  "environment": {
    "allow": []
  },
  "has_custom_ui": false,
  "sweep_exclusion": true,
  "background_service": {
    "auto_restart": false,
    "headless": true,
    "explicit_force_close_suppresses_restart": true
  },
  "test_targets": [
    "pending-native:Standalone tools/local-model"
  ]
}