{
  "id": "global-cleaner",
  "name_key": "tool.name",
  "description_key": "tool.description",
  "version": "1.0.0",
  "display_version": "1.0",
  "display_name": "全域清理",
  "status": "stopped",
  "enabled": false,
  "lifecycle": {
    "status": "retired",
    "stoppable": false
  },
  "labels": [
    "trash"
  ],
  "has_custom_ui": true,
  "permissions": {
    "code_scope": "tool-root-only",
    "database_scope": "tool-database-only"
  },
  "entry": "Standalone tools/global-cleaner/src/main",
  "runtime": {
    "type": "python",
    "entry": "src/main.py",
    "workingDirectory": "."
  },
  "request_channel": {
    "model": "governance-authenticated-shared-layer",
    "runtime_entry": "src/channel_runtime.py",
    "direct_instruction": "PERMISSION_DENIED"
  },
  "distribution": {
    "mode": "special-unpackaged",
    "package": false
  },
  "launch": {
    "mode": "governed-source",
    "selection": "source-only",
    "runtimes": [
      "governed-source-ui"
    ],
    "primary": "governed-source-channel",
    "background": "governed-source-channel",
    "close_program_on_window_exit": true
  },
  "timeout_seconds": 900,
  "capabilities": {
    "global-cleanup": {
      "operations": {
        "preview": [
          "--cleanup-garbage",
          "--scope",
          "global",
          "--dry-run",
          "--json"
        ],
        "clean": [
          "--cleanup-garbage",
          "--scope",
          "global",
          "--json"
        ],
        "clear-managed-temp-files": [
          "--clear-managed-temp-files",
          "--temp-root",
          "global-cleaner/runtime/temp",
          "--json"
        ],
        "clear-test-artifacts": [
          "--clear-managed-temp-files",
          "--temp-root",
          "global-cleaner/runtime/temp/development/test-artifacts",
          "--json"
        ]
      },
      "test_artifacts": {
        "owner": "global-cleaner",
        "storage": "global-cleaner/runtime/temp/development/test-artifacts/run-{request_id}",
        "includes": [
          "pytest-cache",
          "python-pycache",
          "temporary-files",
          "coverage-data",
          "test-reports"
        ],
        "cleanup": "remove-complete-run-root-after-test"
      }
    },
    "managed-backup": {
      "operations": {
        "create": [
          "--create-managed-backup",
          "--backup-owner",
          "main-system",
          "--json"
        ],
        "list": [
          "--list-managed-backups",
          "--json"
        ],
        "extract": [
          "--extract-managed-backup",
          "--backup-owner",
          "main-system",
          "--backup-path",
          "main-system/src-core/main.py",
          "--json"
        ]
      },
      "retention_per_owner": 1,
      "storage": "global-cleaner/data/business/backups/{owner_id}"
    },
    "system-health-check": {
      "operations": {
        "check": [
          "--system-check",
          "--json"
        ]
      }
    }
  },
  "environment": {
    "allow": []
  },
  "hidden_from_toolbox": true,
  "test_targets": [
    "tests/test_global_cleaner_layering.py",
    "tests/test_global_cleaner_precision.py",
    "tests/test_governed_backup_and_repair.py",
    "tests/test_managed_temp_cleanup.py",
    "tests/test_ai_assistant_layering.py",
    "tests/test_ai_collaboration_layering.py",
    "tests/test_ai_channel_governance.py",
    "tests/test_file_sorter_layering.py",
    "tests/test_investment_mobile_governance.py",
    "tests/test_investment_mobile_layering.py",
    "tests/test_main_system_boundaries.py",
    "tests/test_main_system_governance_health.py",
    "tests/test_shared_layer_dual_channels.py",
    "tests/test_shared_layer_ownership.py",
    "tests/test_shared_layer_retention.py",
    "tests/test_vaultly_layering.py"
  ],
  "window": {
    "width": 1040,
    "height": 760,
    "minWidth": 800,
    "minHeight": 600,
    "title_key": "tool.window_title"
  },
  "main_system_independent_tool": false
}
