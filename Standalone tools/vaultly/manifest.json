{
  "id": "vaultly",
  "name_key": "tool.name",
  "description_key": "tool.description",
  "version": "1.0.0",
  "display_version": "1.0",
  "status": "stopped",
  "enabled": true,
  "has_custom_ui": true,
  "permissions": {
    "code_scope": "tool-root-only",
    "database_scope": "tool-database-only",
    "allow_modify": [
      "own-data"
    ],
    "deny": [
      "main-program",
      "other-tools"
    ]
  },
  "entry": "Standalone tools/vaultly/src/main",
  "runtime": {    "type": "retired-python",    "retired_entry": "src/main.py",    "note": "Python lane retired (B167/B38); governed launch resolves runtime.native_entry — absent until the native tool host is built, so it fails closed (TOOL_RUNTIME_RETIRED:python-entry-pending-native-host)",    "workingDirectory": "."  },
  "request_channel": {
    "model": "governance-authenticated-shared-layer",
    "runtime_entry": "shared-layer/csharp/GPTBridge.ChannelHost/publish/GPTBridge.ChannelHost.exe",
    "direct_instruction": "PERMISSION_DENIED"
  },
  "distribution": {
    "mode": "special-unpackaged",
    "package": false
  },
  "launch": {
    "mode": "governed-source",
    "selection": "source-only",
    "runtimes": [
      "governed-source-channel"
    ],
    "primary": "governed-source-channel",
    "background": "governed-source-channel",
    "close_program_on_window_exit": true
  },
  "capabilities": {},
  "automation": {
    "entry": "src/backend/services/vaultly/application/vaultly_scan.py",
    "class": "VaultlyScanMixin",
    "method": "_auto_scan_loop",
    "enabled": false,
    "retired": "B167/B38 python-lane removal; native port pending (automation-flows.json:vaultly-auto-scan)"
  },
  "environment": {
    "allow": []
  },
  "test_targets": [
    "pending-native:Standalone tools/vaultly"
  ],
  "window": {
    "width": 1280,
    "height": 900,
    "minWidth": 1020,
    "minHeight": 720,
    "title_key": "tool.window_title"
  },
  "main_system_independent_tool": true
}
