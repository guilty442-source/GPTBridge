{
  "id": "chinese-semantic-engine",
  "name_key": "tool.name",
  "description_key": "tool.description",
  "version": "1.0.0",
  "display_version": "1.0",
  "shared_permission_profile": "ai-semantic-engine-v1",
  "shared_code_root": "Standalone tools/chinese-semantic-engine",
  "managed_backup_storage": "global-cleaner/data/business/backups/chinese-semantic-engine",
  "status": "stopped",
  "enabled": true,
  "has_custom_ui": false,
  "permissions": {
    "profile": "ai-semantic-engine-v1",
    "business_permission_owner": "chinese-semantic-engine",
    "code_scope": "tool-root-only",
    "database_scope": "tool-database-only",
    "allow_modify": [
      "own-data"
    ],
    "deny": [
      "main-program",
      "other-tools"
    ]
  },
  "entry": "Standalone tools/chinese-semantic-engine/src/backend",
  "runtime": {
    "type": "python",
    "entry": "src/backend/services/chinese_semantic_engine/main.py",
    "workingDirectory": "."
  },
  "request_channel": {
    "model": "governance-authenticated-shared-layer",
    "runtime_entry": "src/channel_runtime.py",
    "direct_instruction": "PERMISSION_DENIED"
  },
  "distribution": {
    "mode": "source-only",
    "package": false
  },
  "launch": {
    "mode": "governed-source-only",
    "selection": "automatic",
    "runtimes": [
      "governed-source-channel"
    ],
    "primary": "governed-source-channel",
    "background": "governed-source-channel",
    "close_program_on_window_exit": true
  },
  "capabilities": {
    "semantic-analysis": {
      "operations": [
        "analyze",
        "embed",
        "retrieve",
        "synthesize",
        "health"
      ],
      "model": "xingcheng-native",
      "data_scope": "tool-database-only",
      "authority": "semantic-processing-only",
      "model_selection": "automatic-only-no-manual-picker",
      "primary_business_models": [
        "xingcheng-native"
      ],
      "entry_gateway": "xingcheng",
      "parameter_scope": "semantic-engine-only",
      "network_access": "none",
      "service_provider": "shared-layer",
      "external_ai_role": "none",
      "ai_authority": "chinese-semantic-engine-under-governance-rule"
    },
    "ai-connections": {
      "transport": "governance-authenticated-ai-channel",
      "channel": "shared-layer/ai-channel",
      "peers": [
        "xingcheng"
      ],
      "allowed_target": "xingcheng",
      "external_ai": "none",
      "queue_when_offline": false,
      "share_database": false,
      "external_ai_api": false,
      "direct_cross_tool_connection": false
    }
  },
  "environment": {
    "allow": [
      "GPTBRIDGE_CHINESE_SEMANTIC_ENGINE_DATA_ROOT",
      "GPTBRIDGE_CHINESE_SEMANTIC_ENGINE_PROFILE"
    ]
  },
  "test_targets": [
    "tests/test_chinese_semantic_engine.py"
  ],
  "window": {
    "width": 1200,
    "height": 800,
    "minWidth": 1000,
    "minHeight": 600,
    "title_key": "tool.window_title"
  },
  "main_system_independent_tool": true,
  "physical_owner_root": "chinese-semantic-engine"
}