{
  "id": "file-sorter",
  "name_key": "tool.name",
  "description_key": "tool.description",
  "version": "1.0.0",
  "display_version": "1.0",
  "status": "stopped",
  "enabled": true,
  "has_custom_ui": true,
  "permissions": {
    "code_scope": "tool-root-only",
    "database_scope": "tool-database-only",
    "allow_modify": [
      "own-data"
    ],
    "deny": [
      "main-program",
      "other-tools"
    ]
  },
  "timeout_seconds": 1800,
  "entry": "Standalone tools/file-sorter/src/main",
  "runtime": {    "type": "csharp", "native_entry": "dist/GPTBridge.ToolHost.App.exe",    "retired_entry": "src/main.py",    "note": "Python lane retired (B167/B38); governed launch resolves runtime.native_entry → C# ToolHost, whose executor table has no file-sorter entry — it falls to DeferredExecutor and commands fail closed (TOOL_EXECUTOR_PENDING_NATIVE_PORT) until the business executor is ported.",    "workingDirectory": "."  },
  "request_channel": {
    "model": "governance-authenticated-shared-layer",
    "runtime_entry": "shared-layer/csharp/GPTBridge.ChannelHost/publish/GPTBridge.ChannelHost.exe",
    "direct_instruction": "PERMISSION_DENIED"
  },
  "distribution": {
    "mode": "special-unpackaged",
    "package": false
  },
  "launch": {
    "primary": "governed-source-channel",
    "background": "governed-source-channel",
    "close_program_on_window_exit": true
  },
  "capabilities": {},
  "automation": {
    "retired_entry": "src/backend/services/file_sorter/application/automation_service.py",
    "class": "FileSorterAutomationService",
    "enabled": false,
    "retired": "B167/B38 python-lane removal; native port pending (automation-flows.json:file-sorter-automation)"
  },
  "startup": {
    "auto_start": false,
    "background": true
  },
  "environment": {
    "allow": [
      "FILE_SORTER_STATE_ROOT",
      "FILE_SORTER_JOURNAL_RETENTION_DAYS"
    ]
  },
  "test_targets": [
    "pending-native:Standalone tools/file-sorter"
  ],
  "window": {
    "width": 1040,
    "height": 780,
    "minWidth": 760,
    "minHeight": 560,
    "title_key": "tool.window_title"
  },
  "main_system_independent_tool": true
}
