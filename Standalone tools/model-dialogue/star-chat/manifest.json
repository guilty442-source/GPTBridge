  "runtime": {    "type": "ui-surface",    "retired_entry": "src/channel_runtime.py",    "note": "Python lane retired (B167/B38); star-chat has no independent process — it is the egui UI surface bound to model-dialogue's governed C# ToolHost (main-system/config/native-ui-surfaces.json).",    "workingDirectory": "."  },
