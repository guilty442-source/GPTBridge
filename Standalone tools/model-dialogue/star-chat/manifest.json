  "status": "stopped",
  "enabled": true,
  "independent_tool": false,
  "main_system_independent_tool": false,
  "host_tool_id": "model-dialogue",
  "companion_tool": true,
  "companion_owner": "model-dialogue",
  "canonical_source_root": "model-dialogue/star-chat",
