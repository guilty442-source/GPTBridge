  "environment": {
    "allow": [
      "GPTBRIDGE_STAR_CHAT_ENABLED",
      "GPTBRIDGE_STAR_CHAT_ALLOW_LAN",
      "GPTBRIDGE_STAR_CHAT_PORT"
    ]
