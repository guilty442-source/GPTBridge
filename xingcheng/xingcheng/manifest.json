  "runtime": {    "type": "native-model-service",    "native_entry": "dist/GPTBridge.ToolHost.App.exe",    "service_contract": "star-model-service-descriptor/v1",    "descriptor": "xingcheng/runtime/ipc/model-service.json",    "worker_entry": "src/backend/services/xingcheng/infrastructure/native_transformer/tools/xc_modeltool.exe",    "worker_mode": "serve --bundle <xingcheng/runtime/settings/native-engine.json::checkpoint>",    "lifecycle_owner": "xingcheng/toolhost-model-service",    "consumer_policy": "csharp-orchestrator-client-only",    "retired_entry": "src/channel_runtime.py",    "note": "Xingcheng is the local native model and owns its own service process: the xingcheng governed ToolHost (native_entry) carries the authenticated loopback /v1/* surface and publishes this descriptor contract; the C++ xc_modeltool serve worker holds the engine in its own child process (B81 separate process/lifecycle).",    "workingDirectory": "."  },
  "distribution": {
    "mode": "special-unpackaged",
    "package": false
  },
  "request_channel": {
    "model": "governance-authenticated-shared-layer",
