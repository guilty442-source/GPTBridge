<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>xc-learning</AssemblyName>
    <RootNamespace>GPTBridge.XingchengLearning</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- No external database client: Rust xstore is the sole metadata
         authority (PostgreSQL retired — Phase D, §50-§51). -->
    <!-- The tool is Windows-only (native toolchain supervision). -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
