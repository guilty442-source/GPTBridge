{
  "expo": {
    "name": "AI投資管家",
    "slug": "gptbridge-investment-manager",
    "version": "1.0.0",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "scheme": "gptbridge-investment",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.gptbridge.investmentmanager",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
