{
  "id": "global-cleaner",
  "name_key": "tool.name",
  "description_key": "tool.description",
  "version": "1.00000",
  "display_version": "1.0",
  "display_name": "全域清理",
  "status": "stopped",
  "enabled": true,
  "has_custom_ui": true,
  "permissions": {
    "code_scope": "tool-root-only",
    "database_scope": "tool-database-only"
  },
  "entry": "global-cleaner/src/main",
  "runtime": {
    "type": "python",
    "entry": "src/main.py",
    "workingDirectory": "."
  },
  "request_channel": {
    "model": "governance-authenticated-shared-layer",
    "runtime_entry": "src/channel_runtime.py",
    "direct_instruction": "PERMISSION_DENIED"
  },
  "launch": {
    "mode": "dual-runtime",
    "selection": "automatic",
    "runtimes": ["governed-source-ui", "executable"],
    "background": "governed-source-channel",
    "close_program_on_window_exit": true
  },
  "executable": {
    "path": "dist/global-cleaner.exe",
    "name": "global-cleaner",
    "console": true
  },
  "timeout_seconds": 900,
  "capabilities": {
    "global-cleanup": {
      "operations": {
        "preview": ["--cleanup-garbage", "--scope", "global", "--dry-run", "--json"],
        "clean": ["--cleanup-garbage", "--scope", "global", "--json"],
        "clear-managed-temp-files": ["--clear-managed-temp-files", "--temp-root", "global-cleaner/runtime/temp", "--json"],
        "clear-test-artifacts": ["--clear-managed-temp-files", "--temp-root", "global-cleaner/runtime/temp/development/test-artifacts", "--json"]
      },
      "test_artifacts": {
        "owner": "global-cleaner",
        "storage": "global-cleaner/runtime/temp/development/test-artifacts/run-{request_id}",
        "includes": ["pytest-cache", "python-pycache", "temporary-files", "coverage-data", "test-reports"],
        "cleanup": "remove-complete-run-root-after-test"
      }
    },
    "managed-backup": {
      "operations": {
        "create": ["--create-managed-backup", "--backup-owner", "main-system", "--json"],
        "list": ["--list-managed-backups", "--json"],
        "extract": ["--extract-managed-backup", "--backup-owner", "main-system", "--backup-path", "main-system/src-core/main.py", "--json"]
      },
      "retention_per_owner": 1,
      "storage": "global-cleaner/data/business/backups/{owner_id}"
    },
    "system-health-check": {
      "operations": {
        "check": ["--system-check", "--json"]
      }
    }
  },
  "environment": { "allow": [] },
  "test_targets": [
    "tests/test_global_cleaner.py"
  ],
  "window": {
    "width": 1040,
    "height": 760,
    "minWidth": 800,
    "minHeight": 600,
    "title_key": "tool.window_title"
  }
}
