#!/usr/bin/env python3
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(PROJECT_ROOT))

from governance_rule.execution.git_tiers import audit_log


def _zero(oid: str) -> bool:
    return bool(oid) and not oid.strip("0")


def _ancestor(old_oid: str, new_oid: str) -> bool:
    return subprocess.run(
        ["git", "merge-base", "--is-ancestor", old_oid, new_oid],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
        creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
    ).returncode == 0


def main() -> int:
    actor = os.environ.get("GIT_AUTHOR_NAME", os.environ.get("USERNAME", "unknown"))
    high_risk: list[str] = []
    updates: list[str] = []
    for line in sys.stdin:
        fields = line.split()
        if len(fields) != 3:
            audit_log(3, "receive", actor, False, "invalid pre-receive input", operation="receive")
            return 1
        old_oid, new_oid, ref = fields
        updates.append(ref)
        if _zero(new_oid):
            high_risk.append(f"delete:{ref}")
        elif not _zero(old_oid) and (ref.startswith("refs/tags/") or not _ancestor(old_oid, new_oid)):
            high_risk.append(f"rewrite:{ref}")
    approved = os.environ.get("GOVERNANCE_AUTHORITY_APPROVAL", "").casefold() in {
        "1", "true", "yes",
    }
    if high_risk and not approved:
        audit_log(3, "receive", actor, False, ",".join(high_risk), operation="receive", result="denied")
        print("[pre-receive] BLOCKED: deletion or history rewrite requires governance approval", file=sys.stderr)
        return 1
    audit_log(
        3 if high_risk else 2,
        "receive",
        actor,
        True,
        ",".join(high_risk or updates),
        operation="receive",
        result="authorized",
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
