#!/usr/bin/env python3
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(PROJECT_ROOT))

from governance_rule.execution.git_tiers import audit_log


def main() -> int:
    actor = os.environ.get("GIT_AUTHOR_NAME", os.environ.get("USERNAME", "unknown"))
    result = subprocess.run(
        ["git", "diff", "--cached", "--check"],
        cwd=PROJECT_ROOT,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        check=False,
        creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
    )
    if result.returncode != 0:
        audit_log(2, "commit", actor, False, "pre-commit staged patch check failed")
        sys.stderr.write(result.stdout)
        sys.stderr.write(result.stderr)
        return result.returncode
    audit_log(2, "commit", actor, True, "pre-commit explicit invocation confirmed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
