        "main-system/src-core/core_system/app_lifecycle.py#GPTBRIDGE_RAG_EAGER"
      ]
    },
    "resident_core": {
      "semantics": "always-resident modules exempt from sleep",
      "bound_to": [
        "main-system/config/sleep-policy.json#never_sleep"
      ]
    },
    "on_demand_rule": {
      "semantics": "first-use activation via governed broker",
      "bound_to": [
        "main-system/src-core/tasks/model_service_activation.py#ModelServiceActivationBroker"
      ]
    }
  },
  "implementation": {
