{
 "artifact": "codex-amendment-request",
 "authority": "request-only",
 "schema": "codex-amendment-request/v2",
 "request_id": "generation-bound-unified-closure-20261002",
 "title": "Unified generation-bound restamp + formal-rule hash binding (single window)",
 "summary": "Single-window unified convergence amendment. (1) formal_rule_registry: restamps version_identity of all 79 participating rules to the successor generation and populates the four evidence hash fields under one declared binding spec (sha256-canonical-json-utf8-v1 over declared artifact views): semantic_hash = canonical descriptor {rule_code, controlling_provision_id, required_inputs, predicate, pass_decision, fail_decision, severity, evidence_schema, low_cost_path, precedence_scope}; evaluator_hash = {rule_code, evaluator_entry, registered, registry:evaluators.json}; test_contract_hash = {rule_code, evidence_schema, low_cost_path, severity, precedence_scope, manifest_checks, manifest:audit_checks_manifest.json}; controlling_provision_hash = {provision_id, provision_type, subject, rule, prohibition, exception} of the controlling article. evaluator_hash/test_contract_hash were empty for all 79 rules and the prior hash scheme is not reproducible post-Python-retirement, so all four fields are restamped under the uniform spec (supersedes legacy values, declared transparently). (2) machine_schema_parity_evidence: rebinds validated_against_version to successor for all 77 rows (content hashes unchanged, verified 77/77 at predecessor). (3) codex_convergence_closure: restamps all 8 rows to successor with recomputed metrics — FORMAL_RULE_CLOSURE open 79->0 PASS, MACHINE_SCHEMA_CLOSURE open 77->0 PASS, aggregate open 442->286; input digests computed over post-change candidate row sets (version_identity placeholder-resolvable). Does not touch normative-surface classification, directory acceptance evidence, obligations, duplication review, or external signatures.",
 "requested_by": "permission-sovereign",
 "origin": "worker devin-desktop full-auto codex-implementation convergence; unified window per governor instruction; divergence report codex-divergence-report-20261002.json; audit gate PASS 3583/3583",
 "problem": {
  "summary": "Generation-bound convergence fields lag the head after each amendment (strict == head binding) and formal_rule_registry hash fields were never populated under a defined binding, keeping FORMAL_RULE_CLOSURE and MACHINE_SCHEMA_CLOSURE open despite verified substrate.",
  "affected": [
   "formal_rule_registry",
   "machine_schema_parity_evidence",
   "codex_convergence_closure"
  ],
  "scope": "generation rebind + uniform hash binding spec declared in this request; no rule semantics, provision text, or schema content modified"
 },
 "change_class": "architecture-authority",
 "required_review": "five-sovereign-audit-unanimous-pass",
 "flow": "A382/A488-non-disruptive-amendment-flow",
 "not_executed": true,
