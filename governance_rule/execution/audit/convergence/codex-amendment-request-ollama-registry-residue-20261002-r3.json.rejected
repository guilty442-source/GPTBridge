  "acceptance": {
    "expected_state": "No active registry row or live provision clause registers the retired Ollama service as an authority: provider OLLAMA_LOCAL reads retired; OLLAMA_LOCAL semantic bindings read retired; FR-OLLAMA-ON-DEMAND surface lifecycle reads retired like retired articles; INV_LOCAL_MODEL is no longer a current inventory item; the ten OLLAMA_* fault codes carry retired_version and no longer appear in the active fault-coverage flow or maintenance manual enumerations; MODEL_RUNTIME_NOT_READY no longer names Ollama; PROJECT_GPTBRIDGE dependencies no longer list Ollama paths; C27 no longer enumerates Ollama; projections rebuild to the successor version",
    "criteria": [
      "local_model_provider_registry.OLLAMA_LOCAL status=retired; no provider row grants the retired service active authority",
      "semantic_model_registry rows for provider OLLAMA_LOCAL read status=retired",
      "current_normative_surface formal-rule:FR-OLLAMA-ON-DEMAND lifecycle_state=retired (status stays current, matching article:B154 convention)",
