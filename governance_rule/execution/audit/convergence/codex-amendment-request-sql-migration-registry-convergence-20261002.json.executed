  "acceptance": {
    "expected_state": "sql_migration_registry: 15 rows carry migration_source_hash equal to the live file SHA-256 (executor source_hash=match); seqs 25/37/45/46 have status=retired; seqs 26/38/47 predecessor_id rewired to MIG_PG_000024/000036/000044 with source_schema_hash equal to the new predecessor's registered target_schema_hash. sql_migration_authority_registry mirrors the same restamp, retirement and repointing. PostgreSQL/artifact parity PASS.",
    "criteria": [
      "all 15 restamped rows report source_hash=match under --migration-status",
      "seqs 25/37/45/46 status=retired in both registries; executor denies them with REGISTRY_STATUS_NOT_EXECUTABLE (fail-closed, never SOURCE_FILE_MISSING)",
      "successor rows 26/38/47 remain topologically linked: predecessor_id resolves to a live predecessor row and source_schema_hash equals that predecessor's registered target_schema_hash",
      "no other registry field mutated; chain arithmetic otherwise untouched",
      "PostgreSQL/artifact parity PASS"
    ],
    "evidence": [
      "main-system/runtime/temp/devin-migration-status-live-20261002.json: live migration-executor-status/v1 - 15 SQL_SCHEMA_VERSION_MISMATCH + 4 SOURCE_FILE_MISSING, 0 receipts",
      "git: last-touch commit of every mismatched file is exactly e487bc473 or 99ba911f3 (governed repair commits); deleted files removed by 26c63f79e sqlite/qdrant retirement",
      "retired migrations created live PG objects (gptbridge_index.sqlite_generation, sqlite_database_class, sqlite_template_release, qdrant_contract) - non-manifest-neutral; downstream target_schema_hash values are stamped on the pre-retirement chain and require a separate governor-side full-chain hash re-derivation before the executor chain can pass verify-target-hash past the retired points"
    ],
    "out_of_scope": [
      "applying any migration to live gptbridge (0 receipts; separate governor authorization required)",
      "re-derivation/restamp of downstream source_schema_hash/target_schema_hash values after the retired rows - the deleted migrations created real PG objects, so every downstream registered target hash embeds objects the retired chain no longer produces; that restamp is a follow-up governor stamp-pipeline action",
      "registration of the 89 unregistered migration files 050-148 (triage report delivered separately; registration requires governed target-hash derivation under the published recipe)",
      "the registered-hash recipe question (governor-side stamp recipe vs executor OBJECT_MANIFEST_V1) - separate convergence item"
    ]
  }
