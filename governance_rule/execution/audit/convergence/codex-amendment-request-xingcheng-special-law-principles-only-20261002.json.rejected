  "request_id": "xingcheng-special-law-principles-only-20261002",
  "title": "Constrain the Xingcheng special law to principles only",
  "summary": "Rewrite B81 as an implementation-neutral statement of Xingcheng identity, scope, authority, rights, duties and prohibitions; move implementation-oriented provisions back to CODEX_MAIN; leave B81 as the sole provision directly contained by the Xingcheng special-law directory.",
  "requested_by": "decision-sovereign",
  "origin": "direct human-governor instruction 2026-10-02: 星澄專法只收入原則，不放實作規範",
  "change_class": "architecture-authority",
  "required_review": "five-sovereign-audit-unanimous-pass",
  "flow": "A382/A488-non-disruptive-amendment-flow",
  "not_executed": true,
  "auto_execute": true,
  "predecessor": {
    "codex_version": "2026-10-02T03:07:27Z",
