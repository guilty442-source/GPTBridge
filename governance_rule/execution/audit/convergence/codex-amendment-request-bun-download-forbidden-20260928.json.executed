      "key": {
        "key": "package_registry_policy"
      },
      "field": "value",
      "proposed": "additions-explicit-permission|removals-and-mode-changes-governed|download-channels-visual-studio-installer-winget|language-managers-detect-only|python-node-forbidden|bun-download-forbidden"
    }
  ],
