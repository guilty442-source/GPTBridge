    "formal_responsibility": "Native git plane successor: C++23 owns execution, C owns the stable ABI and deterministic rules; M0 read-only parity probing (version, worktree status probe via governed git subprocess, bounded output, timeout); never commits, never owns the git plane until a cutover amendment advances it.",
    "maturity_ladder": "M0 scaffold plus read-only probe; M1 status/diff/log parity versus the C# host; M2 sweep port in shadow verify-only mode; M3 sync port plus cutover amendment; M4 native sole owner with the C# host retired to compatibility.",
    "authority_guard": "No new authority, scheduler, store, or governor; the C# GPTBridge.GitAutomation host remains the sole committer through M3; the native engine takes no lock owned by the live watcher."
  },
  "acceptance": {
    "expected_state": "A non-canonical git-engine-native component is registered with C++23/C ownership, read-only M0 scope, and an explicit maturity ladder, with no change to the live committer.",
    "criteria": [
      "exactly one owner per capability (C++23 execution, C ABI)",
      "M0 takes no git-plane lock and performs no write",
      "C# host remains the sole committer",
      "no new authority, scheduler, store, or governor created"
    ],
    "evidence": [
      "native/git_engine build plus self-contained test run",
      "five-sovereign audit unanimous pass on successor candidate"
    ],
    "out_of_scope": [
      "sweep/sync porting (M2/M3) and cutover (M4) are later amendments",
      "no modification to the live C# host or its publish output"
    ]
  }
