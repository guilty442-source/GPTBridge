{
  "id": "system-rescue",
  "name_key": "tool.name",
  "description_key": "tool.description",
  "version": "1.0.0",
  "display_version": "1.0",
  "status": "stopped",
  "enabled": true,
  "lifecycle": {
    "startup": "on-demand",
    "directLoad": false,
    "encapsulated": true,
    "optional": true,
    "stoppable": true,
    "disableable": true,
    "unloadable": true
  },
  "permissions": {
    "code_scope": "tool-root-only",
    "database_scope": "tool-database-only"
  },
  "runtime": {
    "type": "python",
    "entry": "src/main.py",
    "workingDirectory": "."
  },
  "distribution": {
    "mode": "special-unpackaged",
    "package": false
  },
  "background_service": {
    "managed_by": "main-system",
    "headless": true,
    "auto_restart": false,
    "max_restart_attempts": 3,
    "restart_backoff_seconds": 2,
    "explicit_force_close_suppresses_restart": true
  },
  "request_channel": {
    "model": "governance-authenticated-shared-layer",
    "runtime_entry": "src/channel_runtime.py",
    "direct_instruction": "PERMISSION_DENIED"
  },
  "capabilities": {
    "system-health-check": {
      "authority": "main-system-central-packaging-only",
      "role": "packaging-integration",
      "resident": false
    }
  },
  "environment": {
    "allow": []
  },
  "has_custom_ui": false,
  "hidden_from_toolbox": true,
  "test_targets": [
    "tests/test_system_rescue.py"
  ]
}
