{
  "id": "star-chat",
  "name_key": "tool.name",
  "description_key": "tool.description",
  "version": "1.00000",
  "display_version": "1.0",
  "host_tool_id": "xingcheng",
  "runtime_owner_tool_id": "xingcheng",
  "physical_owner_root": "local-model",
  "canonical_source_root": "local-model/model-dialogue",
  "main_system_independent_tool": true,
  "independent_only_in": "main-system",
  "shared_permission_profile": "local-model-platform-v1",
  "shared_cache_owner": "xingcheng",
  "cache_storage": "local-model/runtime/cache/companions/star-chat",
  "backup_owner": "xingcheng",
  "backup_storage": "global-cleaner/data/business/backups/xingcheng",
  "status": "stopped",
  "enabled": true,
  "permissions": {
    "profile": "local-model-platform-v1",
    "business_permission_owner": "xingcheng",
    "settings_owner": "xingcheng",
    "code_scope": "xingcheng-owned-dialogue-interface",
    "database_scope": "all-project-databases-via-xingcheng-excluding-governance-rule",
    "database_actions": ["read", "create-write-save", "append", "update", "execute", "delete", "rollback"],
    "allow_modify": ["model-dialogue-interface-via-xingcheng-owner", "all-project-databases-via-governed-xingcheng"],
    "deny": ["main-program", "other-tools", "direct-model-weights", "separate-business-database", "separate-settings-layer"]
  },
  "entry": "local-model/model-dialogue/src/main",
  "runtime": {
    "type": "python",
    "entry": "src/main.py",
    "workingDirectory": "."
  },
  "request_channel": {
    "model": "governance-authenticated-shared-layer",
    "runtime_entry": "src/channel_runtime.py",
    "direct_instruction": "PERMISSION_DENIED"
  },
  "distribution": {
    "mode": "special-unpackaged",
    "package": false
  },
  "background_service": {
    "managed_by": "main-system",
    "headless": false,
    "auto_restart": true,
    "max_restart_attempts": 3,
    "restart_backoff_seconds": 2,
    "explicit_force_close_suppresses_restart": true,
    "repair_conditions": [
      "FRONTEND_BACKEND_DISCONNECTED",
      "MODEL_RUNTIME_NOT_READY",
      "COMMAND_EXECUTION_FAILED",
      "STREAM_CHANNEL_FAILED"
    ]
  },
  "launch": {
    "primary": "governed-source-channel",
    "background": "governed-source-channel",
    "close_program_on_window_exit": true
  },
  "capabilities": {
    "ai-connections": {
      "service_owner": "xingcheng",
      "entry_gateway": "xingcheng",
      "transport": "governance-authenticated-ai-channel",
      "route_mode": "direct-passthrough-governance-only-limits",
      "automatic_workflow": true,
      "workflow_sequence": ["receive-original-traditional-chinese", "qwen3.8-understand-command-and-normalize-taiwan-chinese", "rnj-1-analyze-code-stem-and-tool-calling-at-workflow-front", "extract-actions-objects-parameters-constraints", "classify-task-and-intensity", "apply-safety-and-permission-gates", "decompose-and-route-subtasks", "execute-and-collect-results", "cross-validate-repair-or-escalate", "integrate-localize-apply-verify-and-report"],
      "language_priority": "traditional-chinese-taiwan-first",
      "translate_to_english_before_intent": true,
      "visual_file_recognition_model": "minicpm-v4.6:q8_0",
      "visual_file_recognition_scope": "image-video-frame-and-document-image-recognition-classification-tagging-summary-only",
      "primary_language": "zh-TW",
      "programming_project_root": "user-selected-folder",
      "outside_programming_scope_allowed": false,
      "selected_model_routing": "direct-to-selected-model-through-xingcheng-platform",
      "structured_task_passthrough": true,
      "database_shared": true,
      "database_owner": "xingcheng",
      "settings_owner": "xingcheng",
      "business_layer_owner": "xingcheng",
      "permission_profile": "local-model-platform-v1",
      "main_system_independent_tool": true,
      "independent_only_in": "main-system",
      "separate_business_layer": false,
      "separate_settings_layer": false,
      "user_command_scope": "all-user-commands-subject-only-to-governance-rule",
      "additional_application_command_restrictions": false,
      "direct_model_access": false,
      "direct_model_access_note": "no-governance-bypass; selected-model-routing-is-direct-inside-the-governed-channel",
      "modes": ["unified-dialogue", "user-programming-commands"],
      "training_ui": false,
      "capability_composition_ui": false,
      "native_internal_training_owner": "star-main-native-model",
      "native_internal_capability_owner": "star-main-native-model",
      "quality_gate_owner": "xingcheng",
      "direct_weight_access": false,
      "automatic_foundation_weight_replacement": false,
      "ollama_training_route": "star-native-internal-only",
      "capability_composition_route": "star-native-internal-database-only",
      "selected_star_native_database_access": "all-project-databases-excluding-governance-rule",
      "database_write": true,
      "database_actions": ["read", "create-write-save", "append", "update", "execute", "delete", "rollback"],
      "investment_manager_direct_access": false,
      "investment_manager_exchange": "governance-authorized-only"
    }
  },
  "environment": {
    "allow": []
  },
  "has_custom_ui": true,
  "test_targets": [
    "tests/test_star_chat.py"
  ],
  "window": {
    "width": 1320,
    "height": 860,
    "minWidth": 900,
    "minHeight": 650,
    "title_key": "tool.window_title"
  }
}
