{
  "id": "vaultly",
  "name": "影音下載自動化",
  "version": "1.0.0",
  "status": "stopped",
  "enabled": true,
  "permissions": {
    "code_scope": "tool-root-only",
    "database_scope": "tool-database-only",
    "allow_modify": ["own-data"],
    "deny": ["main-program", "other-tools"]
  },
  "entry": "platform_tools/vaultly/src/main",
  "runtime": {
    "type": "python",
    "entry": "src/main.py",
    "workingDirectory": "."
  },
  "capabilities": {
    "auto-repair": {
      "entry": "src/auto_repair.py",
      "arguments": ["--json"],
      "authority": "tool-root-only"
    }
  },
  "executable": {
    "path": "dist/vaultly.exe",
    "name": "vaultly",
    "console": true
  },
  "description": "使用正式版專屬 Edge 登入狀態，自動辨識 Instagram/X 個人檔案入口並掃描可見追蹤帳號，提供下載資料夾健康檢查、失敗重跑、自動重試與背景下載監控。",
  "test_targets": [
    "tests/test_vaultly.py"
  ],
  "window": {
    "width": 1280,
    "height": 900,
    "minWidth": 1020,
    "minHeight": 720,
    "title": "影音下載自動化"
  }
}
