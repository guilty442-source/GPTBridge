{
  "id": "ai-assistant",
  "name": "AI投資管家",
  "version": "1.0.0",
  "status": "stopped",
  "enabled": true,
  "permissions": {
    "code_scope": "tool-root-only",
    "database_scope": "tool-database-only",
    "allow_modify": ["own-data"],
    "deny": ["main-program", "other-tools"]
  },
  "entry": "platform_tools/ai-assistant/src/main",
  "runtime": {
    "type": "python",
    "entry": "src/main.py",
    "workingDirectory": "."
  },
  "capabilities": {
    "investment-manager": {
      "authority": "portfolio-state-and-tool-settings-only",
      "data_scope": "tool-database-only",
      "parameter_scope": "investment-manager-only",
      "market_search_owner": "local-ai",
      "investment_analysis_owner": "local-ai",
      "external_ai_role": "discussion-only"
    },
    "ai-connections": {
      "transport": "authenticated-websocket",
      "peers": ["local-ai", "ai-collaboration"],
      "bindings": {
        "local-ai": "GPTBRIDGE_LOCAL_AI_WS_URL",
        "ai-collaboration": "GPTBRIDGE_EXTERNAL_AI_WS_URL"
      },
      "queue_when_offline": false,
      "share_database": false,
      "external_ai_api": false
    },
    "auto-repair": {
      "entry": "src/auto_repair.py",
      "arguments": ["--json"],
      "authority": "tool-root-only"
    }
  },
  "environment": {
    "allow": [
      "ALPHAVANTAGE_API_KEY",
      "GPTBRIDGE_AI_ASSISTANT_DATA_ROOT",
      "GPTBRIDGE_AI_ASSISTANT_PROFILE",
      "GPTBRIDGE_INVESTMENT_MOBILE_SYNC_ALLOW_LAN",
      "GPTBRIDGE_INVESTMENT_MOBILE_SYNC_ENABLED",
      "GPTBRIDGE_INVESTMENT_MOBILE_SYNC_PORT",
      "GPTBRIDGE_INVESTMENT_MOBILE_SYNC_URL",
      "GPTBRIDGE_LOCAL_AI_WS_URL",
      "GPTBRIDGE_EXTERNAL_AI_WS_URL"
    ]
  },
  "executable": {
    "path": "dist/ai-assistant.exe",
    "name": "ai-assistant",
    "console": true
  },
  "description": "AI投資管家 1.0：連接星澄與外部 AI，採用驗證式即時連線、獨立資料庫與無離線指令佇列。",
  "has_custom_ui": true,
  "test_targets": [
    "tests/test_ai_assistant.py",
    "tests/test_investment_manager.py",
    "tests/test_investment_analytics.py",
    "tests/test_investment_v3.py"
  ],
  "window": {
    "width": 1440,
    "height": 920,
    "minWidth": 1120,
    "minHeight": 760,
    "title": "AI投資管家"
  }
}
