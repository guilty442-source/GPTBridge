{
  "id": "vaultly",
  "name_key": "tool.name",
  "description_key": "tool.description",
  "version": "1.00000",
  "display_version": "1.00000",
  "status": "stopped",
  "enabled": true,
  "has_custom_ui": true,
  "permissions": {
    "code_scope": "tool-root-only",
    "database_scope": "tool-database-only",
    "allow_modify": [
      "own-data"
    ],
    "deny": [
      "main-program",
      "other-tools"
    ]
  },
  "entry": "vaultly/src/main",
  "runtime": {
    "type": "python",
    "entry": "src/main.py",
    "workingDirectory": "."
  },
  "request_channel": {
    "model": "governance-authenticated-shared-layer",
    "runtime_entry": "src/channel_runtime.py",
    "direct_instruction": "PERMISSION_DENIED"
  },
  "launch": {
    "mode": "dual-runtime",
    "selection": "automatic",
    "runtimes": [
      "governed-source-channel",
      "executable"
    ],
    "background": "governed-source-channel",
    "close_program_on_window_exit": true
  },
  "capabilities": {},
  "executable": {
    "path": "dist/vaultly.exe",
    "name": "vaultly",
    "console": true
  },
  "environment": {
    "allow": []
  },
  "test_targets": [
    "tests/test_vaultly.py"
  ],
  "window": {
    "width": 1280,
    "height": 900,
    "minWidth": 1020,
    "minHeight": 720,
    "title_key": "tool.window_title"
  }
}
