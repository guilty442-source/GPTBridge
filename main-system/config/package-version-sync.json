  },
  "react": {
   "mode": "upgrade",
   "manifest": {
    "kind": "package-json",
    "path": "main-system/package.json",
    "dep": "react"
   },
   "detect": {
    "kind": "manifest-json",
    "path": "main-system/package.json",
    "field": "dependencies.react",
    "pattern": "(\\d+\\.\\d+\\.\\d+)"
   },
   "upgrade": {
    "cwd": "main-system",
    "argv": [
     "npm",
     "update",
     "react"
    ]
   },
   "codex_refs": [
    {
     "provision_id": "B170",
     "field": "rule",
     "pattern": "React (\\d+\\.\\d+\\.\\d+)"
    },
    {
     "provision_id": "B166",
     "field": "rule",
     "pattern": "React=(\\d+\\.\\d+\\.\\d+)",
     "render": "React={v}"
    }
   ]
  },
  "numpy": {
   "mode": "upgrade",
   "detect": {
    "kind": "pip",
    "package": "numpy",
    "pattern": "(\\d+\\.\\d+\\.\\d+)"
   },
   "upgrade": {
    "cwd": ".",
    "argv": [
     "main-system/.venv/Scripts/python.exe",
     "-m",
     "pip",
     "install",
     "--upgrade",
     "numpy"
    ]
   },
   "codex_refs": [
    {
     "provision_id": "B170",
     "field": "rule",
     "pattern": "NumPy (\\d+\\.\\d+\\.\\d+)"
    }
   ]
  },
  "cargo-deps": {
   "mode": "upgrade",
   "manifest": {
    "kind": "cargo-toml",
    "path": "Standalone tools/vectord-rs/Cargo.toml"
   },
   "upgrade": {
    "cwd": "Standalone tools/vectord-rs",
    "argv": [
     "cargo",
     "update"
    ]
   }
  },
  "go-deps": {
   "mode": "upgrade",
   "manifest": {
    "kind": "go-mod",
    "path": "Standalone tools/searchd-go/go.mod"
   },
   "upgrade": {
    "cwd": "Standalone tools/searchd-go",
    "argv": [
     ".tools/go/go/bin/go.exe",
     "get",
     "-u",
     "./..."
    ],
    "env": {
     "GOPROXY": "off",
     "GOSUMDB": "off",
     "GOTOOLCHAIN": "local",
     "GOWORK": "off",
     "GOFLAGS": "-buildvcs=false"
    }
   }
  },
  "julia-deps": {
   "mode": "detect",
   "manifest": {
    "kind": "project-toml",
    "path": "Standalone tools/julia-compute/Project.toml"
   }
  },
  "dotnet-deps": {
   "mode": "detect",
   "manifest": {
    "kind": "dotnet-proj",
    "paths": [
     "Standalone tools/business-logic-csharp",
     "Standalone tools/business-logic-fsharp",
     "Standalone tools/process-metrics-csharp",
     "native/test_suites/csharp",
     "native/test_suites/csharp_investment",
     "Standalone tools/investment-mobile/native/oms"
    ]
   }
  },
  "go-system": {
   "mode": "upgrade",
   "detect": {
    "kind": "command",
    "argv": [
     "C:/Program Files/Go/bin/go.exe",
     "version"
    ],
    "pattern": "go(\\d+\\.\\d+\\.\\d+)"
   },
   "upgrade": {
    "cwd": ".",
    "argv": [
     "winget",
     "upgrade",
     "--id",
     "GoLang.Go",
     "-e",
     "--silent",
     "--accept-source-agreements",
     "--accept-package-agreements",
