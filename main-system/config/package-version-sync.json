{
 "schema": "star-package-version-sync/v1",
 "comment": "A624: automation core owns package version reconciliation — detect installed toolchain/package versions, run governed upgrades where a package manager exists, then emit codex amendment requests so declared versions converge to actual. enabled=false is the kill switch; per-ecosystem mode=off|detect|upgrade. PACKAGE-LIST: this technologies table is the sole registered package inventory; no entry may be added, removed or have its mode changed without an explicit permission artifact. Downloads use exactly Visual Studio Installer and Winget; language package managers (cargo/go modules/nuget/npm/pip) never perform a network download and stay detect-only over vendored or already-registered artifacts. Python and Node are forbidden.",
 "enabled": true,
 "intake_dir": "governance_rule/execution/audit/convergence",
 "state_file": "runtime/state/package-version-sync.json",
 "audit_log": "runtime/logs/package-version-sync.jsonl",
 "upgrade_timeout_s": 600,
 "detect_timeout_s": 30,
 "registry_policy": {
  "authoritative": true,
  "additions": "explicit-permission-artifact-required",
  "removals_and_mode_changes": "governed-amendment-required",
  "download_channels": [
   "visual-studio-installer",
   "winget"
  ],
  "language_managers": "no-network-download|detect-only",
  "forbidden": [
   "python",
   "node"
  ]
 },
 "technologies": {
  "go-toolchain": {
   "mode": "detect",
   "detect": {
    "kind": "command",
    "argv": [
     ".tools/go/go/bin/go.exe",
     "version"
    ],
    "pattern": "go(\\d+\\.\\d+\\.\\d+)"
   },
   "codex_refs": [
    {
     "provision_id": "B170",
     "field": "rule",
     "pattern": "Go (\\d+\\.\\d+\\.\\d+)"
    }
   ]
  },
  "rust-toolchain": {
   "mode": "upgrade",
   "detect": {
    "kind": "command",
    "argv": [
     "rustc",
     "--version"
    ],
    "pattern": "rustc (\\d+\\.\\d+\\.\\d+)"
   },
   "codex_refs": [
    {
     "provision_id": "B170",
     "field": "rule",
     "pattern": "Rust (\\d+\\.\\d+\\.\\d+)"
    }
   ],
   "upgrade": {
    "cwd": ".",
    "argv": [
     "winget",
     "upgrade",
     "--id",
     "Rustlang.Rustup",
     "-e",
     "--silent",
     "--accept-source-agreements",
     "--accept-package-agreements",
     "--disable-interactivity"
    ]
   }
  },
  "dotnet-runtime": {
   "mode": "upgrade",
   "detect": {
    "kind": "command",
    "argv": [
     "dotnet",
     "--list-sdks"
    ],
    "pattern": "(\\d+)\\.",
    "extract": "major"
   },
   "codex_refs": [
    {
     "provision_id": "B170",
     "field": "rule",
     "pattern": "\\.NET (\\d+)",
     "render": ".NET {v}"
    },
    {
     "provision_id": "B166",
     "field": "rule",
     "pattern": "\\.NET (\\d+)",
     "render": ".NET {v}"
    }
   ],
   "upgrade": {
    "cwd": ".",
    "argv": [
     "winget",
     "upgrade",
     "--id",
     "Microsoft.DotNet.SDK.10",
     "-e",
     "--silent",
     "--accept-source-agreements",
     "--accept-package-agreements",
     "--disable-interactivity"
    ]
   }
  },
  "postgresql": {
   "mode": "upgrade",
   "detect": {
    "kind": "postgres",
    "query": "SHOW server_version",
    "pattern": "(\\d+\\.\\d+)"
   },
   "codex_refs": [
    {
     "provision_id": "B170",
     "field": "rule",
     "pattern": "PostgreSQL (\\d+\\.\\d+)"
    },
    {
     "provision_id": "B166",
     "field": "rule",
     "pattern": "PostgreSQL=(\\d+\\.\\d+)",
     "render": "PostgreSQL={v}"
    }
   ],
   "upgrade": {
    "cwd": ".",
    "argv": [
     "winget",
     "upgrade",
     "--id",
     "PostgreSQL.PostgreSQL.18",
     "-e",
     "--silent",
     "--accept-source-agreements",
     "--accept-package-agreements",
     "--disable-interactivity"
    ]
   }
  },
  "git": {
   "mode": "upgrade",
   "detect": {
    "kind": "command",
    "argv": [
     "git",
     "--version"
    ],
    "pattern": "git version (\\d+\\.\\d+\\.\\d+)"
   },
   "codex_refs": [
    {
     "provision_id": "B166",
     "field": "rule",
     "pattern": "Git=(\\d+\\.\\d+\\.\\d+)",
     "render": "Git={v}"
    }
   ],
   "upgrade": {
    "cwd": ".",
    "argv": [
     "winget",
     "upgrade",
     "--id",
     "Git.Git",
     "-e",
     "--silent",
     "--accept-source-agreements",
     "--accept-package-agreements",
     "--disable-interactivity"
    ]
   }
  },
  "cargo-deps": {
   "mode": "detect",
   "manifest": {
    "kind": "cargo-toml",
    "path": "Standalone tools/vectord-rs/Cargo.toml"
   }
  },
  "go-deps": {
   "mode": "detect",
   "manifest": {
    "kind": "go-mod",
    "path": "Standalone tools/searchd-go/go.mod"
   }
  },
  "julia-deps": {
   "mode": "detect",
   "manifest": {
    "kind": "project-toml",
    "path": "Standalone tools/julia-compute/Project.toml"
   }
  },
  "dotnet-deps": {
   "mode": "detect",
   "manifest": {
    "kind": "dotnet-proj",
    "paths": [
     "Standalone tools/business-logic-csharp",
     "Standalone tools/business-logic-fsharp",
     "Standalone tools/process-metrics-csharp",
     "native/test_suites/csharp",
     "native/test_suites/csharp_investment",
     "Standalone tools/investment-mobile/native/oms"
    ]
   }
  },
  "go-system": {
   "mode": "upgrade",
   "detect": {
    "kind": "command",
    "argv": [
     "C:/Program Files/Go/bin/go.exe",
     "version"
    ],
    "pattern": "go(\\d+\\.\\d+\\.\\d+)"
   },
   "upgrade": {
    "cwd": ".",
    "argv": [
     "winget",
     "upgrade",
     "--id",
     "GoLang.Go",
     "-e",
     "--silent",
     "--accept-source-agreements",
     "--accept-package-agreements",
     "--disable-interactivity"
    ]
   },
   "codex_refs": []
  }
 }
}
