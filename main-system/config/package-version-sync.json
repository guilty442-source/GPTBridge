{
 "schema": "star-package-version-sync/v1",
 "comment": "A624: automation core owns package version reconciliation — detect installed toolchain/package versions, run governed upgrades where a package manager exists, then emit codex amendment requests so declared versions converge to actual. enabled=false is the kill switch; per-ecosystem mode=off|detect|upgrade. System/toolchain packages upgrade through winget (single governed package channel); vendored toolchains (A622: go) and language-ecosystem deps (npm/pip/cargo/go) stay detect-only or on their own managers — winget cannot manage library graphs.",
 "enabled": true,
 "intake_dir": "governance_rule/execution/audit/convergence",
 "state_file": "runtime/state/package-version-sync.json",
 "audit_log": "runtime/logs/package-version-sync.jsonl",
 "upgrade_timeout_s": 600,
 "detect_timeout_s": 30,
 "technologies": {
  "python-runtime": {
   "mode": "upgrade",
   "detect": {
    "kind": "command",
    "argv": [
     "main-system/.venv/Scripts/python.exe",
     "--version"
    ],
    "pattern": "Python (\\d+\\.\\d+\\.\\d+)"
   },
   "codex_refs": [
    {
     "provision_id": "B170",
     "field": "rule",
     "pattern": "Python (\\d+\\.\\d+\\.\\d+)"
    },
    {
     "provision_id": "B4",
     "field": "rule",
     "pattern": "python(\\d+\\.\\d+\\.\\d+)"
    }
   ],
   "upgrade": {
    "cwd": ".",
    "argv": [
     "winget",
     "upgrade",
     "--id",
     "Python.Python.3.14",
     "-e",
     "--silent",
     "--accept-source-agreements",
     "--accept-package-agreements",
     "--disable-interactivity"
    ]
   }
  },
  "go-toolchain": {
   "mode": "detect",
   "detect": {
    "kind": "command",
    "argv": [
     ".tools/go/go/bin/go.exe",
     "version"
    ],
    "pattern": "go(\\d+\\.\\d+\\.\\d+)"
   },
   "codex_refs": [
    {
     "provision_id": "B170",
     "field": "rule",
     "pattern": "Go (\\d+\\.\\d+\\.\\d+)"
    },
    {
     "provision_id": "B4",
     "field": "rule",
     "pattern": "go(\\d+\\.\\d+\\.\\d+)"
    }
   ]
  },
  "rust-toolchain": {
   "mode": "upgrade",
   "detect": {
    "kind": "command",
    "argv": [
     "rustc",
     "--version"
    ],
    "pattern": "rustc (\\d+\\.\\d+\\.\\d+)"
   },
   "codex_refs": [
    {
     "provision_id": "B170",
     "field": "rule",
     "pattern": "Rust (\\d+\\.\\d+\\.\\d+)"
    },
    {
     "provision_id": "B4",
     "field": "rule",
     "pattern": "rust(\\d+\\.\\d+\\.\\d+)"
    }
   ],
   "upgrade": {
    "cwd": ".",
    "argv": [
     "winget",
     "upgrade",
     "--id",
     "Rustlang.Rustup",
     "-e",
     "--silent",
     "--accept-source-agreements",
     "--accept-package-agreements",
     "--disable-interactivity"
    ]
   }
  },
  "dotnet-runtime": {
   "mode": "upgrade",
   "detect": {
    "kind": "command",
    "argv": [
     "dotnet",
     "--list-sdks"
    ],
    "pattern": "(\\d+)\\.",
    "extract": "major"
   },
   "codex_refs": [
    {
     "provision_id": "B170",
     "field": "rule",
     "pattern": "\\.NET (\\d+)",
     "render": ".NET {v}"
    },
    {
     "provision_id": "B166",
     "field": "rule",
     "pattern": "\\.NET (\\d+)",
     "render": ".NET {v}"
    },
    {
     "provision_id": "B4",
     "field": "rule",
     "pattern": "\\.NET (\\d+)",
     "render": ".NET {v}"
    }
   ],
   "upgrade": {
    "cwd": ".",
    "argv": [
     "winget",
     "upgrade",
     "--id",
     "Microsoft.DotNet.SDK.10",
     "-e",
     "--silent",
     "--accept-source-agreements",
     "--accept-package-agreements",
     "--disable-interactivity"
    ]
   }
  },
  "postgresql": {
   "mode": "upgrade",
   "detect": {
    "kind": "postgres",
    "query": "SHOW server_version",
    "pattern": "(\\d+\\.\\d+)"
   },
   "codex_refs": [
    {
     "provision_id": "B170",
     "field": "rule",
     "pattern": "PostgreSQL (\\d+\\.\\d+)"
    },
    {
     "provision_id": "B166",
     "field": "rule",
     "pattern": "PostgreSQL=(\\d+\\.\\d+)",
     "render": "PostgreSQL={v}"
    },
    {
     "provision_id": "B4",
     "field": "rule",
     "pattern": "sql-postgresql(\\d+\\.\\d+)",
     "render": "sql-postgresql{v}"
    }
   ],
   "upgrade": {
    "cwd": ".",
    "argv": [
     "winget",
     "upgrade",
     "--id",
     "PostgreSQL.PostgreSQL.18",
     "-e",
     "--silent",
     "--accept-source-agreements",
     "--accept-package-agreements",
     "--disable-interactivity"
    ]
   }
  },
  "git": {
   "mode": "upgrade",
   "detect": {
    "kind": "command",
    "argv": [
     "git",
     "--version"
    ],
    "pattern": "git version (\\d+\\.\\d+\\.\\d+)"
   },
   "codex_refs": [
    {
     "provision_id": "B166",
     "field": "rule",
     "pattern": "Git=(\\d+\\.\\d+\\.\\d+)",
     "render": "Git={v}"
    }
   ],
   "upgrade": {
    "cwd": ".",
    "argv": [
     "winget",
     "upgrade",
     "--id",
     "Git.Git",
     "-e",
     "--silent",
     "--accept-source-agreements",
     "--accept-package-agreements",
     "--disable-interactivity"
