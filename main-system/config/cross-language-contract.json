  "error_contract": {
    "description": "unified cross-language error codes. Boundaries carry error_code plus bounded metadata plus correlation_id only. No stack traces cross trust boundaries; no free-form exception strings as decision conditions.",
    "codes": [
      "OK",
      "INVALID_ARGUMENT",
      "PERMISSION_DENIED",
      "NOT_READY",
      "TIMEOUT",
      "CANCELLED",
      "RESOURCE_BUSY",
      "CONTRACT_MISMATCH",
      "GENERATION_MISMATCH",
      "DATA_INTEGRITY_ERROR",
      "INTERNAL_ERROR"
    ],
    "language_mapping": {
      "rust": "Result<T, E> with code enums; never panic across boundary",
      "cpp": "std::expected / status codes; exceptions converted at the ABI edge",
      "c": "integer status codes; fail-closed negatives",
      "csharp": "typed results; exceptions converge at the application boundary",
      "fsharp": "typed results (Result/Option); exceptions converge at the application boundary",
      "go": "error values carrying codes",
      "javascript": "typed error objects {error_code, message, correlation_id}",
      "python": "exceptions inside the Python domain only; codes on the wire",
      "julia": "ok:false envelopes with op-scoped codes"
    }
  },
  "memory_ownership": {
    "rules": [
      "every native struct declares allocator owner, free owner, lifetime, mutability, thread safety, alignment",
      "same-process hot paths target zero-copy or one-copy; cross-process prefers formal binary IPC",
      "no new ungoverned shared-memory mechanisms",
      "canonical owners: Python owns memory at the pybind edge (memory_contract.py BufferOwnership); C++ owns weight bundles with stable addresses; Rust owns vectord store; callers own opaque handles and transfer buffers"
    ]
  },
