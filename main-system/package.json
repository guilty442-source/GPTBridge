{
  "name": "gptbridge-auto-agent-ide",
  "version": "1.0.0",
  "description": "GPTBridge Windows 11 Stable Baseline",
  "private": true,
  "author": "GPTBridge Development Team",
  "scripts": {
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File launcher/scripts/start.ps1",
    "dev": "node scripts/dev.mjs",
    "launcher:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File launcher/scripts/install.ps1",
    "launcher:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File launcher/scripts/start.ps1 -PrepareOnly",
    "launcher:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File launcher/scripts/start.ps1",
    "type-check": "npx.cmd tsc --noEmit",
    "test:size-breakdown": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/test_platform_tool_size_breakdown.ts",
    "test:perf-slo": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/test_perf_slo.ts",
    "lint:imports": "cd .. && main-system\\.venv\\Scripts\\python.exe -m governance_rule.execution.audit",
    "governance:audit": "cd .. && main-system\\.venv\\Scripts\\python.exe -m governance_rule.execution.audit",
    "governance:check": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" ../governance_rule/execution/typescript/scripts/run-checkers.ts",
    "governance:fix": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" ../governance_rule/execution/typescript/scripts/run-fixers.ts",
    "governance:report": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" ../governance_rule/execution/typescript/scripts/generate-report.ts",
    "doctor": ".venv\\Scripts\\python.exe scripts/doctor_environment.py --strict",
    "doctor:fix": ".venv\\Scripts\\python.exe scripts/doctor_environment.py --fix-electron --strict",
    "version:sync": ".venv\\Scripts\\python.exe scripts/sync_version.py sync",
    "version:check": ".venv\\Scripts\\python.exe scripts/sync_version.py check",
    "version:set": ".venv\\Scripts\\python.exe scripts/sync_version.py set",
    "check:circular": "npx.cmd madge --circular --extensions ts,tsx,js,jsx,mjs --ts-config tsconfig.json src-ui/renderer",
    "check:imports": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" ../governance_rule/execution/typescript/scripts/run-checkers.ts --category import",
    "check:ui": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" ../governance_rule/execution/typescript/scripts/run-checkers.ts --category ui",
    "check:runtime": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" ../governance_rule/execution/typescript/scripts/run-checkers.ts --category runtime",
    "build:renderer": "vite build",
    "build:templates": "vite build -c vite.templates.config.mjs",
    "build:native": ".venv\\Scripts\\python.exe src-core/core_system/native/build_native.py",
    "build:platform-renderer": ".venv\\Scripts\\python.exe src-core/tasks/platform_packager.py --build-renderers-only --all",
    "build:app": "npm.cmd run build:renderer && npm.cmd run build:templates && npm.cmd run build:platform-renderer",
    "package:tools": "npm.cmd run build:templates && .venv\\Scripts\\python.exe src-core/tasks/platform_packager.py --all",
    "package:tool": ".venv\\Scripts\\python.exe src-core/tasks/platform_packager.py",
    "package:changed": ".venv\\Scripts\\python.exe src-core/tasks/platform_packager.py --changed",
    "verify:tools": ".venv\\Scripts\\python.exe src-core/tasks/platform_packager.py --verify --all",
    "build": "npm.cmd run version:check && npm.cmd run governance:audit && npm.cmd run governance:check && npm.cmd run check:imports && npm.cmd run check:circular && npm.cmd run check:runtime && npm.cmd run type-check && npm.cmd run build:app",
    "test:ipc-client": "ts-node --files --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/test_ipc_client_contract.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.4.5",
    "madge": "^8.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
