{
  "name": "gptbridge-auto-agent-ide",
  "version": "1.0.0",
  "description": "GPTBridge Windows 11 Stable Baseline",
  "private": true,
  "author": "GPTBridge Development Team",
  "scripts": {
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File launcher/scripts/start.ps1",
    "launcher:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File launcher/scripts/install.ps1",
    "launcher:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File launcher/scripts/start.ps1 -PrepareOnly",
    "launcher:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File launcher/scripts/start.ps1",
    "test:size-breakdown": "cargo test --manifest-path src-tauri/Cargo.toml -p gptbridge-core native::sizes",
    "test:perf-slo": "cargo test --manifest-path src-tauri/Cargo.toml -p gptbridge-core state::perf_slo",
    "lint:imports": "cd .. && main-system\\.venv\\Scripts\\python.exe -m governance_rule.execution.audit",
    "governance:audit": "cd .. && main-system\\.venv\\Scripts\\python.exe -m governance_rule.execution.audit",
    "doctor": ".venv\\Scripts\\python.exe scripts/doctor_environment.py --strict",
    "doctor:fix": ".venv\\Scripts\\python.exe scripts/doctor_environment.py --strict",
    "version:sync": ".venv\\Scripts\\python.exe scripts/sync_version.py sync",
    "version:check": ".venv\\Scripts\\python.exe scripts/sync_version.py check",
    "version:set": ".venv\\Scripts\\python.exe scripts/sync_version.py set",
    "build:native": ".venv\\Scripts\\python.exe src-core/core_system/native/build_native.py",
    "build:platform-renderer": ".venv\\Scripts\\python.exe scripts/packager/platform_packager.py --build-renderers-only --all",
    "build:app": "npm.cmd run build:platform-renderer",
    "package:tools": ".venv\\Scripts\\python.exe scripts/packager/platform_packager.py --all",
    "package:tool": ".venv\\Scripts\\python.exe scripts/packager/platform_packager.py",
    "package:changed": ".venv\\Scripts\\python.exe scripts/packager/platform_packager.py --changed",
    "verify:tools": ".venv\\Scripts\\python.exe scripts/packager/platform_packager.py --verify --all",
    "build": "npm.cmd run version:check && npm.cmd run governance:audit && npm.cmd run build:app",
    "test:ipc-client": "node scripts/test_ipc_client_contract.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "vite": "^8.3.1"
  }
}
